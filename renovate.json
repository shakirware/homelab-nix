{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/London",
  "prConcurrentLimit": 5,

  "nix": {
    "enabled": true
  },

  "lockFileMaintenance": {
    "enabled": true
  },

  "customManagers": [
    {
      "customType": "regex",
      "description": "Update digest-pinned container images declared in Nix modules",
      "managerFilePatterns": ["/(^|/)nix\\/.*\\.nix$/"],
      "matchStrings": [
        "\"(?<depName>[a-z0-9][a-z0-9._/-]*):(?<currentValue>[^\"\\s@]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],

  "packageRules": [
    {
      "description": "Keep InvoicePlane on the MariaDB 12.3 LTS line; 13.x is short-term",
      "matchPackageNames": ["mariadb"],
      "allowedVersions": "<13"
    },
    {
      "description": "Standard Notes sidecars stay on the major lines its self-hosting compose file uses",
      "matchFileNames": ["nix/services/standardnotes/**"],
      "matchPackageNames": [
        "docker.io/library/mysql",
        "docker.io/library/redis",
        "docker.io/localstack/localstack"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "linuxserver arr images are pinned to version-X.Y.Z.BUILD tags",
      "matchPackageNames": [
        "lscr.io/linuxserver/prowlarr",
        "lscr.io/linuxserver/radarr",
        "lscr.io/linuxserver/sonarr"
      ],
      "versioning": "regex:^version-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$"
    },
    {
      "description": "linuxserver Bazarr is pinned to version-vX.Y.Z tags",
      "matchPackageNames": ["lscr.io/linuxserver/bazarr"],
      "versioning": "regex:^version-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "linuxserver Jellyfin only publishes 12.x as X.Y[.Z]ubuNNNN-lsN tags",
      "matchPackageNames": ["lscr.io/linuxserver/jellyfin"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?ubu(?<compatibility>\\d+)-ls(?<build>\\d+)$"
    },
    {
      "description": "qBittorrent tags carry the libtorrent line (version-5.3.0_v2.1.2); stay on the current line",
      "matchPackageNames": ["lscr.io/linuxserver/qbittorrent"],
      "versioning": "regex:^version-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:_v(?<compatibility>\\d+\\.\\d+)\\.\\d+)?(?:-r(?<build>\\d+))?$"
    },
    {
      "description": "Exact version tags only get PRs when the tag itself changes",
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      "description": "Floating tags only change by digest; batch those into one monthly PR",
      "matchUpdateTypes": ["digest"],
      "matchCurrentValue": "/^(latest(-pg\\d+)?|\\d+(\\.\\d+)?(-alpine)?)$/",
      "enabled": true,
      "groupName": "floating image digests",
      "schedule": ["* 0-4 1 * *"]
    },
    {
      "description": "Immich server and machine learning must run the same release",
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/immich-machine-learning"
      ],
      "groupName": "immich"
    },
    {
      "description": "Profilarr and its parser must run the same release",
      "matchPackageNames": [
        "ghcr.io/dictionarry-hub/profilarr",
        "ghcr.io/dictionarry-hub/profilarr-parser"
      ],
      "groupName": "profilarr"
    },
    {
      "description": "Immich's Postgres image only changes when upstream's compose file does",
      "matchPackageNames": ["ghcr.io/immich-app/postgres"],
      "enabled": false
    },
    {
      "description": "Postgres majors need a dump/restore",
      "matchPackageNames": ["postgres"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
