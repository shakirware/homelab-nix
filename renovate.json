{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/London",
  "prConcurrentLimit": 5,

  "nix": {
    "enabled": true
  },

  "lockFileMaintenance": {
    "enabled": true
  },

  "customManagers": [
    {
      "customType": "regex",
      "description": "Update digest-pinned container images declared in Nix modules",
      "managerFilePatterns": ["/(^|/)nix\\/.*\\.nix$/"],
      "matchStrings": [
        "image\\s*=\\s*\"(?<depName>[^\"@]+):(?<currentValue>[^\"\\s@]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],

  "packageRules": [
    {
      "description": "Keep InvoicePlane on the MariaDB 12.3 LTS line; 13.x is short-term",
      "matchPackageNames": ["mariadb"],
      "allowedVersions": "<13"
    },
    {
      "matchPackageNames": [
        "lscr.io/linuxserver/prowlarr",
        "lscr.io/linuxserver/qbittorrent",
        "lscr.io/linuxserver/radarr",
        "lscr.io/linuxserver/sonarr"
      ],
      "extractVersion": "^version-(?<version>.*)$",
      "versioning": "loose"
    }
  ]
}
