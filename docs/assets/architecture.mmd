%% Source of architecture.svg, exported from Mermaid Live with the "neo" look.
%% The export needs three fixes or GitHub shows it cropped: add a viewBox and
%% width="600" to the root <svg>, drop the pan/zoom transform on the
%% svg-pan-zoom_viewport group, and remove the unused Font Awesome stylesheet.
flowchart TB
    subgraph clients["Clients"]
        direction LR
        trusted["Trusted LAN<br/>Computers · phones"]
        iot["IoT LAN<br/>Smart devices · TVs"]
        remote["Remote clients<br/>Tailscale"]
    end

    router["MikroTik hAP ax²<br/>VLANs 1 / 20 / 30 / 31 / 40 · Default-deny firewall"]

    subgraph pve["Proxmox VE · Single physical host"]
        direction TB

        gw["vm-gw<br/>AdGuard · Unbound · Caddy<br/>Tailscale · Homepage"]

        subgraph applications["Applications"]
            direction LR
            media["vm-media<br/>Jellyfin · Media automation"]
            apps["vm-apps<br/>Home Assistant · Personal apps"]
            sensitive["vm-sensitive<br/>Finance · Notes · Invoicing"]
        end

        subgraph infrastructure["Storage & observability"]
            direction LR
            storage["vm-storage<br/>mergerfs · NFS"]
            monitoring["vm-monitoring<br/>Prometheus · Grafana<br/>Loki · Alertmanager"]
        end

        ci["vm-ci<br/>GitHub Actions runners<br/>Isolated VLAN 30"]
        release["vm-release<br/>Release runner<br/>Isolated VLAN 31"]
    end

    external["External heartbeat monitor"]
    github["GitHub Actions"]

    trusted --> router
    iot --> router
    router -->|"DNS · HTTPS"| gw
    remote -->|"Tailscale"| gw

    gw -->|"Caddy"| media
    gw -->|"Caddy"| apps
    gw -->|"Caddy"| sensitive
    gw -->|"Caddy"| monitoring

    storage -->|"NFS · read-write"| media
    storage -->|"NFS · read-only"| gw

    monitoring -.->|"Heartbeat"| external
    ci -.->|"Internet only"| github
    release -.->|"Internet only"| github
