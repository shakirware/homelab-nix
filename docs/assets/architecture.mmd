%% Source of architecture.svg. Mermaid Live exports omit the viewBox;
%% add one (and a width/height) or GitHub shows the diagram cropped.
flowchart TB
    management["Declarative management<br/>Git · OpenTofu · NixOS · Colmena<br/>sops-nix · Renovate"]

    subgraph clients["Clients"]
        direction LR
        trusted["Trusted LAN<br/>VLAN 1<br/>Computers, phones"]
        iot["IoT LAN<br/>VLAN 40<br/>Smart devices, TVs"]
        remote["Remote clients"]
    end

    router["Router<br/>MikroTik hAP ax²<br/>VLAN routing"]

    subgraph pve["Proxmox VE · Single physical host"]
        direction TB

        subgraph production["VLAN 20 · Production services"]
            direction TB

            gw["vm-gw<br/>AdGuard · Unbound · Caddy<br/>Tailscale · Homepage"]

            subgraph applications["Applications"]
                direction LR
                media["vm-media<br/>Jellyfin · TuliProx · Media automation"]
                apps["vm-apps<br/>Immich · Home Assistant<br/>Personal apps"]
                sensitive["vm-sensitive<br/>Finance · Notes · Invoicing"]
            end

            subgraph infrastructure["Storage & observability"]
                direction LR

                subgraph vmstorage["vm-storage · Local HDDs"]
                    direction TB

                    storage["NFSv4 · mergerfs · Restic"]

                    diskA["diskA · Immich originals<br/>/srv/diskA/photos"]

                    subgraph diskB["diskB · Encrypted Restic repositories"]
                        direction LR
                        photoBackup["Photo originals backup<br/>LOCAL ONLY"]
                        infraBackup["Selected app data & DB dumps<br/>Includes Immich PostgreSQL"]
                    end
                end

                monitoring["vm-monitoring<br/>Prometheus · Grafana · Loki<br/>Probes · Alertmanager"]
            end
        end

        subgraph ci_zone["VLAN 30 · Untrusted CI"]
            ci["vm-ci<br/>3 ephemeral PR runners<br/>Internet-only outbound"]
        end

        subgraph release_zone["VLAN 31 · Trusted releases"]
            release["vm-release<br/>1 ephemeral release runner<br/>Internet-only outbound"]
        end
    end

    github["GitHub Actions<br/>Separate PR / release repositories"]
    b2["Backblaze B2 · Off-site<br/>Small app & database backups only"]
    telegram["Telegram alerts"]
    heartbeat["External heartbeat monitor"]

    management -.->|"Managed router configuration"| router
    management -.->|"Provision & deploy VMs"| pve

    trusted --> router
    iot --> router
    router -->|"DNS · HTTPS"| gw
    remote -->|"Tailscale"| gw

    gw -->|"Caddy"| media
    gw -->|"Caddy"| apps
    gw -->|"Caddy"| sensitive
    gw -->|"Caddy"| monitoring

    storage -->|"NFSv4 /media"| media
    storage -->|"NFSv4 /media"| gw
    storage -->|"NFSv4 /photos"| apps

    diskA -.->|"Nightly Restic photo backup"| photoBackup
    infraBackup -.->|"Scheduled copy"| b2

    router -.->|"Syslog"| monitoring
    monitoring -.->|"Alerts"| telegram
    monitoring -.->|"Health-gated heartbeat"| heartbeat

    ci -.->|"PR checks"| github
    release -.->|"Build · publish · deploy"| github

    classDef originals fill:#123b49,stroke:#3b9ca9,color:#ffffff;
    classDef localBackup fill:#243b2a,stroke:#7ab783,color:#ffffff;
    classDef offsiteBackup fill:#352849,stroke:#b6a1ef,color:#ffffff;

    class diskA originals;
    class photoBackup localBackup;
    class infraBackup,b2 offsiteBackup;
