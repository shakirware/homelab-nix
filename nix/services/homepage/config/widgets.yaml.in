- logo:
    icon: mdi-server

- greeting:
    text_size: xl
    text: Homelab

- resources:
    label: Gateway (vm-gw)
    cpu: true
    memory: true

- resources:
    label: Storage
    expanded: true
    disk:
      - /srv/media

- openmeteo:
    label: London
    # Coordinates come from SOPS (secrets/vm-gw.yaml); the repository is public.
    latitude: {{HOMEPAGE_VAR_WEATHER_LAT}}
    longitude: {{HOMEPAGE_VAR_WEATHER_LON}}
    timezone: Europe/London
    units: metric
    cache: 5
    format:
      maximumFractionDigits: 1

- datetime:
    text_size: xl
    locale: en-GB
    format:
      dateStyle: medium
      timeStyle: short
      hourCycle: h23
