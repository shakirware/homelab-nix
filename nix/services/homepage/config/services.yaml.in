- Media:
    - Jellyfin:
        icon: mdi-jellyfish
        href: https://@JELLYFIN_HOST@
        description: Media server
        siteMonitor: https://@JELLYFIN_HOST@
        widget:
          type: jellyfin
          url: http://@MEDIA_IP@:8096
          key: {{HOMEPAGE_VAR_JELLYFIN_KEY}}
          # Jellyfin 12 dropped /emby routes and ?api_key=; v2 uses the Authorization header.
          version: 2
          enableBlocks: true
          showEpisodeNumber: true
          enableNowPlaying: true
          expandOneStreamToTwoRows: false
    - Grimmory:
        icon: mdi-bookshelf
        href: https://@GRIMMORY_HOST@
        description: Ebook library and reader
        siteMonitor: https://@GRIMMORY_HOST@
        widget:
          type: booklore
          url: http://@MEDIA_IP@:6060
          username: {{HOMEPAGE_VAR_GRIMMORY_USER}}
          password: {{HOMEPAGE_VAR_GRIMMORY_PASS}}
    - Audiobookshelf:
        icon: mdi-book-music
        href: https://@AUDIOBOOKSHELF_HOST@
        description: Audiobook library and player
        siteMonitor: https://@AUDIOBOOKSHELF_HOST@
        widget:
          type: audiobookshelf
          url: http://@MEDIA_IP@:13378
          key: {{HOMEPAGE_VAR_AUDIOBOOKSHELF_KEY}}
    - Pinchflat:
        icon: mdi-youtube
        href: https://@PINCHFLAT_HOST@
        description: YouTube media archiver
        siteMonitor: https://@PINCHFLAT_HOST@
    - Tuliprox:
        icon: mdi-television-play
        href: https://@IPTV_HOST@
        description: Tuliprox IPTV (Xtream)
        siteMonitor: https://@IPTV_HOST@
        widget:
          type: customapi
          url: http://@MEDIA_IP@:8901/api/v1/status
          refreshInterval: 30000
          mappings:
            - field: active_users
              label: Users
              format: number
            - field: active_user_connections
              label: Streams
              format: number
            - field: version
              label: Version
              format: text
    - neTV:
        icon: mdi-television-classic
        href: https://@NETV_HOST@
        description: IPTV player
        siteMonitor: https://@NETV_HOST@

- Requests:
    - Seerr:
        icon: mdi-movie-search
        href: https://@SEERR_HOST@
        description: Requests & approvals for Jellyfin
        siteMonitor: https://@SEERR_HOST@
        widget:
          type: jellyseerr
          url: http://@MEDIA_IP@:5055
          key: {{HOMEPAGE_VAR_SEERR_KEY}}
          fields: ["pending", "approved", "available", "issues"]
          highlight:
            pending:
              numeric:
                - level: danger
                  when: gte
                  value: 25
                - level: warn
                  when: gte
                  value: 5
                - level: good
                  when: eq
                  value: 0
            issues:
              numeric:
                - level: danger
                  when: gte
                  value: 5
                - level: warn
                  when: gte
                  value: 1
                - level: good
                  when: eq
                  value: 0
    - Shelfmark:
        icon: mdi-book-search
        href: https://@SHELFMARK_HOST@
        description: Ebook search and request automation
        siteMonitor: https://@SHELFMARK_HOST@
    - ReadMeABook:
        icon: mdi-headphones
        href: https://@READMEABOOK_HOST@
        description: Audiobook requests and automation
        siteMonitor: https://@READMEABOOK_HOST@

- Automation:
    - Sonarr:
        icon: mdi-television-classic
        href: https://@SONARR_HOST@
        description: TV shows automation
        siteMonitor: https://@SONARR_HOST@
        widget:
          type: sonarr
          url: http://@MEDIA_IP@:8989
          key: {{HOMEPAGE_VAR_SONARR_KEY}}
          enableQueue: true
          fields: ["wanted", "queued", "series"]
          highlight:
            queued:
              numeric:
                - level: danger
                  when: gte
                  value: 20
                - level: warn
                  when: gte
                  value: 5
                - level: good
                  when: eq
                  value: 0
            wanted:
              numeric:
                - level: warn
                  when: gte
                  value: 10
                - level: good
                  when: lt
                  value: 10
    - Radarr:
        icon: mdi-movie-open
        href: https://@RADARR_HOST@
        description: Movies automation
        siteMonitor: https://@RADARR_HOST@
        widget:
          type: radarr
          url: http://@MEDIA_IP@:7878
          key: {{HOMEPAGE_VAR_RADARR_KEY}}
          enableQueue: true
          fields: ["wanted", "missing", "queued", "movies"]
          highlight:
            queued:
              numeric:
                - level: danger
                  when: gte
                  value: 20
                - level: warn
                  when: gte
                  value: 5
                - level: good
                  when: eq
                  value: 0
            missing:
              numeric:
                - level: warn
                  when: gte
                  value: 10
                - level: good
                  when: lt
                  value: 10
    - Bazarr:
        icon: mdi-subtitles
        href: https://@BAZARR_HOST@
        description: Subtitles for Sonarr and Radarr
        siteMonitor: https://@BAZARR_HOST@
        widget:
          type: bazarr
          url: http://@MEDIA_IP@:6767
          key: {{HOMEPAGE_VAR_BAZARR_KEY}}
    - Prowlarr:
        icon: mdi-magnify-scan
        href: https://@PROWLARR_HOST@
        description: Indexer manager
        siteMonitor: https://@PROWLARR_HOST@
        widget:
          type: prowlarr
          url: http://@MEDIA_IP@:9696
          key: {{HOMEPAGE_VAR_PROWLARR_KEY}}
          fields: ["numberOfQueries", "numberOfFailQueries", "numberOfGrabs", "numberOfFailGrabs"]
          highlight:
            numberOfFailQueries:
              numeric:
                - level: danger
                  when: gte
                  value: 50
                - level: warn
                  when: gte
                  value: 10
                - level: good
                  when: lt
                  value: 10
            numberOfFailGrabs:
              numeric:
                - level: danger
                  when: gte
                  value: 20
                - level: warn
                  when: gte
                  value: 5
                - level: good
                  when: lt
                  value: 5
    - qBittorrent:
        icon: mdi-download-network
        href: https://@QBITTORRENT_HOST@
        description: Downloader UI
        siteMonitor: https://@QBITTORRENT_HOST@
        widget:
          type: qbittorrent
          url: http://@MEDIA_IP@:8080
          username: {{HOMEPAGE_VAR_QBITTORRENT_USER}}
          password: {{HOMEPAGE_VAR_QBITTORRENT_PASS}}
          fields: ["download", "upload", "seed", "leech"]
          enableLeechProgress: true
          enableLeechSize: true
          highlight:
            leech:
              numeric:
                - level: warn
                  when: gte
                  value: 5
                - level: good
                  when: lt
                  value: 5
    - Profilarr:
        icon: mdi-format-list-bulleted
        href: https://@PROFILARR_HOST@
        description: Profiles/quality automation for Arr apps
        siteMonitor: https://@PROFILARR_HOST@
    - Cleanuparr:
        icon: mdi-broom
        href: https://@CLEANUPARR_HOST@
        description: Arr queue cleanup automation
        siteMonitor: https://@CLEANUPARR_HOST@
    - Gluetun:
        icon: mdi-vpn
        description: Mullvad VPN for qBittorrent, Prowlarr and Tuliprox
        widget:
          type: gluetun
          url: http://@MEDIA_IP@:8001
          key: {{HOMEPAGE_VAR_GLUETUN_KEY}}
          version: 2
          fields: ["public_ip", "region", "country"]

- Upcoming:
    - Calendar:
        icon: mdi-calendar
        widget:
          type: calendar
          view: agenda
          maxEvents: 10
          showTime: true
          firstDayInWeek: monday
          timezone: Europe/London
          integrations:
            - type: sonarr
              service_group: Automation
              service_name: Sonarr
              color: teal
              params:
                unmonitored: false
            - type: radarr
              service_group: Automation
              service_name: Radarr
              color: amber
              params:
                unmonitored: false

- Infrastructure:
    - Proxmox:
        icon: mdi-server
        href: https://@PROXMOX_HOST@
        description: Hypervisor UI
        siteMonitor: https://@PROXMOX_HOST@
        widget:
          type: proxmox
          url: https://@PROXMOX_IP@:8006
          username: {{HOMEPAGE_VAR_PROXMOX_TOKEN}}
          password: {{HOMEPAGE_VAR_PROXMOX_SECRET}}
          node: pve
    - Storage:
        icon: mdi-harddisk
        href: https://@GRAFANA_HOST@
        description: Usage per drive
        widget:
          type: prometheusmetric
          url: http://@MONITORING_IP@:9090
          refreshInterval: 300000
          metrics:
            - label: Disk A
              query: 100 * (1 - node_filesystem_avail_bytes{job="node",instance="storage.@BASE_DOMAIN@:9100",mountpoint="/srv/diskA"} / node_filesystem_size_bytes{job="node",instance="storage.@BASE_DOMAIN@:9100",mountpoint="/srv/diskA"})
              format:
                type: percent
                options:
                  maximumFractionDigits: 1
            - label: Disk B
              query: 100 * (1 - node_filesystem_avail_bytes{job="node",instance="storage.@BASE_DOMAIN@:9100",mountpoint="/srv/diskB"} / node_filesystem_size_bytes{job="node",instance="storage.@BASE_DOMAIN@:9100",mountpoint="/srv/diskB"})
              format:
                type: percent
                options:
                  maximumFractionDigits: 1
            - label: Media free
              query: node_filesystem_avail_bytes{job="node",instance="storage.@BASE_DOMAIN@:9100",mountpoint="/srv/media"}
              format:
                type: bytes
            - label: Downloads free
              query: node_filesystem_avail_bytes{job="node",instance="media.@BASE_DOMAIN@:9100",mountpoint="/srv/downloads"}
              format:
                type: bytes

    - AdGuard:
        icon: mdi-shield-check
        href: https://@ADGUARD_HOST@
        description: DNS & ad blocking
        siteMonitor: https://@ADGUARD_HOST@
        widget:
          type: adguard
          url: http://@GW_IP@:3000
          username: {{HOMEPAGE_VAR_ADGUARD_USER}}
          password: {{HOMEPAGE_VAR_ADGUARD_PASS}}
          fields: ["queries", "blocked", "filtered", "latency"]
          highlight:
            latency:
              numeric:
                - level: danger
                  when: gte
                  value: 300
                - level: warn
                  when: gte
                  value: 100
                - level: good
                  when: lt
                  value: 100
    - Router:
        icon: mdi-router-wireless
        href: https://@ROUTER_HOST@
        description: Gateway admin
        siteMonitor: https://@ROUTER_HOST@
        widget:
          type: mikrotik
          # REST over plain HTTP: the router's www service and firewall admit only
          # vm-gw on port 80, and the homepage user is read-only, bound to vm-gw.
          url: http://@ROUTER_IP@
          username: homepage
          password: {{HOMEPAGE_VAR_MIKROTIK_PASS}}
          fields: ["uptime", "cpuLoad", "memoryUsed", "numberOfLeases"]
    - Home Assistant:
        icon: mdi-home-assistant
        href: https://@HOME_ASSISTANT_HOST@
        description: Smart home and Ring AI summaries
        siteMonitor: https://@HOME_ASSISTANT_HOST@
        widget:
          type: homeassistant
          url: http://@APPS_IP@:8123
          key: {{HOMEPAGE_VAR_HOME_ASSISTANT_KEY}}
          fields: ["people_home", "lights_on", "switches_on"]
    - Obsidian Sync (CouchDB):
        icon: mdi-notebook
        href: https://@OBSIDIAN_SYNC_HOST@/_utils/
        description: CouchDB UI
        siteMonitor: https://@OBSIDIAN_SYNC_HOST@
    - Tailscale:
        icon: mdi-vpn
        href: https://login.tailscale.com/admin/machines
        description: Subnet router and exit node (vm-gw)
        widget:
          type: tailscale
          deviceid: {{HOMEPAGE_VAR_TAILSCALE_DEVICE_ID}}
          key: {{HOMEPAGE_VAR_TAILSCALE_KEY}}
          fields: ["address", "last_seen", "expires", "update_available"]

- Monitoring:
    - Grafana:
        icon: mdi-chart-box
        href: https://@GRAFANA_HOST@
        description: Dashboards (Prometheus + Loki)
        siteMonitor: https://@GRAFANA_HOST@
        widget:
          type: grafana
          version: 2
          url: http://@MONITORING_IP@:3000
          username: {{HOMEPAGE_VAR_GRAFANA_USER}}
          password: {{HOMEPAGE_VAR_GRAFANA_PASS}}
          fields: ["dashboards", "datasources", "totalalerts", "alertstriggered"]
    - Prometheus:
        icon: mdi-fire
        href: https://@PROMETHEUS_HOST@
        description: Targets up/down
        siteMonitor: https://@PROMETHEUS_HOST@
        widget:
          type: prometheus
          url: http://@MONITORING_IP@:9090
          fields: ["targets_up", "targets_down", "targets_total"]
    - Alertmanager:
        icon: mdi-bell-alert
        href: https://@ALERTMANAGER_HOST@
        description: Prometheus alerts (Watchdog excluded)
        siteMonitor: https://@ALERTMANAGER_HOST@
        widget:
          type: prometheusmetric
          url: http://@MONITORING_IP@:9090
          refreshInterval: 60000
          metrics:
            - label: Firing
              query: count(ALERTS{alertstate="firing",alertname!="Watchdog"}) or vector(0)
              format:
                type: number
            - label: Pending
              query: count(ALERTS{alertstate="pending"}) or vector(0)
              format:
                type: number
    - Tracearr:
        icon: mdi-chart-timeline-variant
        href: https://@TRACEARR_HOST@
        description: Media activity & tracing
        siteMonitor: https://@TRACEARR_HOST@
        widget:
          type: tracearr
          url: http://@MEDIA_IP@:3003
          key: {{HOMEPAGE_VAR_TRACEARR_KEY}}
          view: summary
          fields: ["streams", "transcodes", "directplay", "bitrate"]

- Personal:
    - Yamtrack:
        icon: mdi-format-list-checks
        href: https://@YAMTRACK_HOST@
        description: Books, movies and media tracking
        siteMonitor: https://@YAMTRACK_HOST@
    - Kaneo:
        icon: mdi-view-column
        href: https://@KANEO_HOST@
        description: Projects and tasks
        siteMonitor: https://@KANEO_HOST@

    - Actual Budget:
        icon: mdi-cash-multiple
        href: https://@ACTUAL_HOST@
        description: Budgeting
        siteMonitor: https://@ACTUAL_HOST@
    - Standard Notes:
        icon: mdi-note-text
        href: https://@STANDARDNOTES_HOST@
        description: Notes
        siteMonitor: https://@STANDARDNOTES_HOST@
    - InvoicePlane:
        icon: mdi-file-document-edit
        href: https://@INVOICE_HOST@
        description: Invoicing
        siteMonitor: https://@INVOICE_HOST@
